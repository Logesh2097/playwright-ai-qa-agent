# Template for local development. Create your own copy with `make env`, which
# also generates a random database password. Never commit the resulting .env.

# --- Application --------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated browser origins allowed to call the API directly. Leave empty
# when the frontend reaches the API through its own proxy (the default setup).
CORS_ALLOWED_ORIGINS=

# Base URL of the web app; used for links in emails.
PUBLIC_BASE_URL=http://localhost:5173

# --- Authentication -----------------------------------------------------------
# Signing key for access tokens (at least 32 characters). Filled in by `make env`.
JWT_SECRET_KEY=
# The refresh cookie is marked Secure unless this is false. Keep it true wherever
# the site is served over HTTPS; false is for plain-HTTP local development only.
AUTH_COOKIE_SECURE=false

# Master key that encrypts stored test credentials, as "<version>:<base64 of 32 bytes>".
# Filled in by `make env`. Back it up: without it stored credentials cannot be read.
# To rotate, append a higher version ("1:...,2:..."); keep old versions until re-wrapped.
CREDENTIAL_MASTER_KEYS=

# --- AI service (optional) ----------------------------------------------------
# Without a key the platform runs, and AI features answer "not configured".
# openai: uses OPENAI_API_KEY. gemini: uses GEMINI_API_KEY with Google's native API.
# Only the chosen provider's key is read.
LLM_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
# Client-side pacing, requests per minute per process; 0 = off. The API and the worker
# count separately, so use less than half the provider's quota (for example 6 on a
# Gemini free tier that allows 15).
LLM_REQUESTS_PER_MINUTE=0
# Attempts per model call (1-6) and the wait between them in seconds (doubling from the
# base up to the maximum). Raise them for a provider that is often briefly overloaded.
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY_S=1
LLM_RETRY_MAX_DELAY_S=20
# Model used for requirement analysis. Required once a key is set; there is no
# default on purpose. It must support structured outputs (JSON schema).
LLM_MODEL_ANALYSIS=
# Model used to write test cases. Leave empty to use the analysis model.
LLM_MODEL_GENERATION=
# openai only: an OpenAI-compatible gateway or proxy; leave empty for api.openai.com.
# Do not point it at Gemini: use LLM_PROVIDER=gemini instead.
OPENAI_BASE_URL=
# USD per million tokens for that model. With both set, cost is recorded per call.
LLM_INPUT_PRICE_PER_MTOK=
LLM_OUTPUT_PRICE_PER_MTOK=
# Monthly spending cap per organization in USD. Needs the prices above.
LLM_MONTHLY_BUDGET_USD=

# --- Browser automation ---------------------------------------------------------
# Shared secrets between the worker and the two browser services. Filled in by `make env`.
RUNNER_TOKEN=
EGRESS_ADMIN_TOKEN=
ENGINE_TOKEN=
# Test engine: runs at the same time, and limits of its container.
ENGINE_MAX_RUNS=2
ENGINE_MEMORY=4g
ENGINE_CPUS=2
# Browsers that may run at the same time, and the longest a session may live (seconds).
RUNNER_MAX_SESSIONS=4
RUNNER_SESSION_MAX_SECONDS=900
# Memory limit of the runner container.
RUNNER_MEMORY=3g
# Private subnet for the internal runner network. Change only if it collides with
# a network you already use.
RUNNER_SUBNET=10.213.77.0/24

# --- PostgreSQL ---------------------------------------------------------------
# Schema owner. Used only by the migration job.
POSTGRES_USER=qa_agent
POSTGRES_DB=qa_agent
# Filled in by `make env`.
POSTGRES_PASSWORD=
# Role the API and worker connect as. It is created by the migration job and is
# subject to row-level security. Passwords must be URL-safe (letters and digits).
APP_DB_USER=qa_agent_app
# Filled in by `make env`.
APP_DB_PASSWORD=

# --- Host ports (change if something else already uses them) ------------------
API_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# --- Build ---------------------------------------------------------------------
# UID the backend containers run as; match your host user so bind-mounted files
# stay writable (`id -u`).
APP_UID=1000
VITE_APP_NAME=QA Agent

# GitHub API address. Change only for GitHub Enterprise Server.
GITHUB_API_URL=https://api.github.com

# Bearer token for GET /metrics (24+ characters). Empty: the endpoint does not exist.
METRICS_TOKEN=

# --- Mail (invitations and password resets) -----------------------------------
# Empty host: nothing is sent; in development the message is written to the API log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
