# Frontend build-time configuration. Values prefixed with VITE_ are embedded in the
# browser bundle, so never put secrets here.

# Base URL of the versioned API. Leave unset to use the same-origin proxy (/api/v1).
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=QA Agent

# Dev server only: where Vite forwards /api, /healthz and /readyz. Not sent to the browser.
DEV_PROXY_TARGET=http://localhost:8000
