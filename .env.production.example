# Production configuration. Copy to .env.production, fill in every empty value,
# keep the file out of version control and readable only by the deploying user.
# Prefer injecting these from a secret manager; see docs/deployment.md.

# --- Address ------------------------------------------------------------------
# Public https address of the web application. Used in emails, CI answers and GitHub links.
PUBLIC_BASE_URL=https://qa.example.com
# Where the web server listens on this host. Keep it on loopback or a private
# interface and terminate TLS in front of it.
WEB_BIND=127.0.0.1
WEB_PORT=8080
# Addresses of the proxy in front, whose X-Forwarded-For is trusted.
FORWARDED_ALLOW_IPS=*
# Only if a browser application on another origin calls the API directly.
CORS_ALLOWED_ORIGINS=

# --- Secrets: generate each with `openssl rand -base64 48 | tr -dc A-Za-z0-9 | head -c 48`
JWT_SECRET_KEY=
RUNNER_TOKEN=
EGRESS_ADMIN_TOKEN=
ENGINE_TOKEN=
# "1:<base64 of 32 random bytes>": `echo "1:$(openssl rand -base64 32)"`.
# Back it up apart from the database. Without it stored credentials cannot be read.
CREDENTIAL_MASTER_KEYS=
# Optional. With it set, GET /metrics exists on the API (internal network only).
METRICS_TOKEN=

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=qa_agent
POSTGRES_DB=qa_agent
POSTGRES_PASSWORD=
# The role the API and worker use. Subject to row-level security. Letters and digits only.
APP_DB_USER=qa_agent_app
APP_DB_PASSWORD=

# --- Mail (invitations and password resets) -----------------------------------
# Without a host no mail is sent and those flows cannot be completed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- AI service (optional) ----------------------------------------------------
# "openai" or "gemini". Only the chosen provider's key is read.
LLM_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
# Requests per minute per process (API and worker count separately); 0 = off.
LLM_REQUESTS_PER_MINUTE=0
# Attempts per model call (1-6) and the wait between them in seconds (doubling from the
# base up to the maximum). Raise them for a provider that is often briefly overloaded.
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY_S=1
LLM_RETRY_MAX_DELAY_S=20
LLM_MODEL_ANALYSIS=
LLM_MODEL_GENERATION=
OPENAI_BASE_URL=
LLM_INPUT_PRICE_PER_MTOK=
LLM_OUTPUT_PRICE_PER_MTOK=
LLM_MONTHLY_BUDGET_USD=

# --- Capacity -----------------------------------------------------------------
API_WORKERS=2
API_MEMORY=1g
WORKER_MEMORY=1g
ENGINE_MAX_RUNS=2
ENGINE_MEMORY=4g
ENGINE_CPUS=2
RUNNER_MAX_SESSIONS=4
RUNNER_SESSION_MAX_SECONDS=900
RUNNER_MEMORY=3g
RUNNER_SUBNET=10.213.78.0/24
EVIDENCE_RETENTION_DAYS=30

# --- Other --------------------------------------------------------------------
LOG_LEVEL=INFO
GITHUB_API_URL=https://api.github.com
VITE_APP_NAME=QA Agent
# Tag the images of one release alike.
IMAGE_PREFIX=qa-agent
IMAGE_TAG=latest
